{
  "name": "playwright-test-demo",
  "version": "1.0.0",
  "description": "Demo test project created with playwright/test",
  "main": "index.js",
  "scripts": {
    "hero:test": "npx playwright test --config=_project-herokuapp-components-tests/playwright.config.ts",
    "hero:test:ui": "npx playwright test --ui --config=_project-herokuapp-components-tests/playwright.config.ts",
    "build": "tsc -b",
    "lint": "eslint .",
    "update": "npm install @playwright/test@latest",
    "download:chromium": "npx playwright install chromium",
    "download:firefox": "npx playwright install firefox",
    "download:webkit": "npx playwright install webkit",
    "version": "npx @playwright/test --version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dneprokos/playwright-test-demo.git"
  },
  "keywords": [
    "aqa",
    "playwright",
    "ts"
  ],
  "author": "Kostiantyn Teltov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dneprokos/playwright-test-demo/issues"
  },
  "homepage": "https://github.com/dneprokos/playwright-test-demo#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@types/mssql": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "mssql": "^12.7.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "agentql": "^1.18.1",
    "joi": "^17.13.3"
  }
}
